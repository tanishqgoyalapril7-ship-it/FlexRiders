{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["bom1"],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,uploads/**,venv/**,*.db,seed_data.py,reset_clean_db.py}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
