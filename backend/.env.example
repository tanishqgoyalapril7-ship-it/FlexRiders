# Super Riders backend configuration. Copy to backend/.env and fill in real values.
# Never commit backend/.env — it is gitignored.

PROJECT_NAME=Super Riders API
# Use a long random string in any shared or production environment.
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Local development (zero setup):
DATABASE_URL=sqlite:///./super_riders.db
# Supabase / PostgreSQL (URL-encode special characters in the password, e.g. @ -> %40):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Real SMS codes through an Android phone running SMS-Gateway-Free (github.com/mdakashhossain1/SMS-Gateway-Free).
# When both are set: rider sign-up needs the SMS code for the mobile number, and riders can log in with an SMS OTP.
# The URL must be reachable from this server (phone's LAN IP for a local backend; a public HTTPS tunnel when hosted).
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
SMS_COUNTRY_CODE=+91
# Or Fast2SMS (fast2sms.com → Dev API): OTP SMS to Indian numbers straight from the server, no gateway phone
# needed (works on Vercel). When set, it is used instead of the gateway phone.
FAST2SMS_API_KEY=
# Or Twilio Verify (preferred when set): Account SID and Auth Token from the Twilio console home page, and the
# Service SID (VA...) of a Verify service (Verify → Services → Create). A trial account texts only verified numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_VERIFY_CODE_LENGTH=6
# Or plain Twilio SMS instead of Verify (works with the trial's free SMS): the Twilio phone number to send from
# (+1...), with the Account SID and Auth Token above and no Verify service SID.
TWILIO_FROM_NUMBER=
# Free local testing with no SMS provider: the code is shown on the phone screen instead of being texted.
# Never works on a hosted server.
SMS_TEST_MODE=false
# SMS codes per number / per device each hour (0 = no limit, only for local testing)
SMS_PER_NUMBER_PER_HOUR=3
SMS_PER_CLIENT_PER_HOUR=10
# Or 2Factor (2factor.in → dashboard → API key): OTP SMS to Indian numbers. TWOFACTOR_TEMPLATE is optional:
# the name of your own approved OTP template (otherwise 2Factor's default OTP template is used).
TWOFACTOR_API_KEY=
# Or MSG91 (msg91.com → OTP → Templates): Auth Key (profile → Authkey) and the approved OTP template's
# MSG91 Template ID (its code placeholder is ##OTP##). Used before 2Factor when both are set.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWOFACTOR_TEMPLATE=
# If your Fast2SMS account has no "OTP" route, use the DLT route: your approved sender ID (header) and the
# Fast2SMS message ID of your approved template, e.g. "{#var#} is your FlexRiders verification code. It expires in 10 minutes."
FAST2SMS_SENDER_ID=
FAST2SMS_TEMPLATE_ID=

# Development OTP, only used when no SMS gateway is set (admin accounts can never use OTP login)
ENABLE_OTP_LOGIN=true
MOCK_OTP_CODE=123456

# Campaign rules (defaults shown)
# Photos: 3 daily slots (Morning / Evening / Night). Set true to only accept each slot inside its time window.
ENFORCE_PHOTO_SLOT_WINDOWS=false
# In-app "slot is open" / "closes soon" reminders, sent by a once-a-minute loop in the API process (IST).
SLOT_NOTIFICATIONS_ENABLED=true
SLOT_REMINDER_MINUTES=30
# T-shirt return incentive (₹) for campaigns that don't set their own; credited once when an admin marks the return.
TSHIRT_RETURN_INCENTIVE_DEFAULT=50
# Base URL of the public campaign page shared with brands (empty = dashboard address + /campaign/)
PUBLIC_CAMPAIGN_BASE_URL=
FULFILLMENT_ON_TRACK_PCT=95
FULFILLMENT_AT_RISK_PCT=80
LOW_SAMPLE_MIN_DAYS=3
LOW_SAMPLE_MIN_RIDER_DAYS=20
RIDER_BEHIND_PCT=80
INACTIVE_MISSED_DAYS=3

# Debugging: log why each campaign is shown/hidden in the rider app
CAMPAIGN_VISIBILITY_LOG=false

# --- Geo-targeted campaigns ---
# Area search (rider working areas, campaign targets). OpenStreetMap Nominatim by default: no key, but its
# usage policy needs an identifying User-Agent with a contact address and at most ~1 request/second.
# Point GEOCODER_URL at a self-hosted Nominatim or a commercial Nominatim-compatible provider for more volume.
GEOCODER_URL=https://nominatim.openstreetmap.org/search
GEOCODER_USER_AGENT=FlexRiders/1.0 (flexridersindia@gmail.com)
GEOCODER_COUNTRY_CODES=in
# Prefilled on new campaigns (each campaign stores and can change its own values).
CAMPAIGN_DEFAULT_INITIAL_RADIUS_KM=2
CAMPAIGN_DEFAULT_MAX_RADIUS_KM=8
CAMPAIGN_DEFAULT_EXPANSION_STEP_KM=1
CAMPAIGN_DEFAULT_EXPANSION_INTERVAL_MIN=60
# A rider's reported location counts as "current" for this many minutes.
RIDER_LOCATION_MAX_AGE_MIN=180
# Campaigns starting within this many hours show as "Opening soon" with a countdown.
OPENING_SOON_HOURS=48
