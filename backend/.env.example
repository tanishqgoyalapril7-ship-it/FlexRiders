# Super Riders Environment Configuration
PROJECT_NAME="Super Riders API"
API_V1_STR="/api/v1"
SECRET_KEY="super-riders-secret-key-production-change-this-in-prod"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Database: SQLite for zero-config dev, PostgreSQL for production
DATABASE_URL="sqlite:///./super_riders.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/super_riders"

# AWS / Cloud Storage (optional in dev, required in prod)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="super-riders-documents"

# Firebase Cloud Messaging
FIREBASE_PROJECT_ID=""
FIREBASE_CREDENTIALS_JSON=""

# Payment Gateway (Razorpay / Cashfree / Stripe)
PAYMENT_GATEWAY_KEY=""
PAYMENT_GATEWAY_SECRET=""
PAYMENT_WEBHOOK_SECRET=""

# Business Configuration
MULTI_BRAND_ASSIGNMENT=false
ENABLE_OTP_LOGIN=true
MOCK_OTP_CODE="123456"
