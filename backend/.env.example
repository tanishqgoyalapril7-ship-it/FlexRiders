# Super Riders backend configuration. Copy to backend/.env and fill in real values.
# Never commit backend/.env — it is gitignored.

PROJECT_NAME=Super Riders API
# Use a long random string in any shared or production environment.
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Local development (zero setup):
DATABASE_URL=sqlite:///./super_riders.db
# Supabase / PostgreSQL (URL-encode special characters in the password, e.g. @ -> %40):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Development OTP (there is no SMS provider yet; admin accounts can never use OTP login)
ENABLE_OTP_LOGIN=true
MOCK_OTP_CODE=123456

# Campaign rules (defaults shown)
PHOTOS_PER_DAY=3
FULFILLMENT_ON_TRACK_PCT=95
FULFILLMENT_AT_RISK_PCT=80
LOW_SAMPLE_MIN_DAYS=3
LOW_SAMPLE_MIN_RIDER_DAYS=20
RIDER_BEHIND_PCT=80
INACTIVE_MISSED_DAYS=3

# Debugging: log why each campaign is shown/hidden in the rider app
CAMPAIGN_VISIBILITY_LOG=false
