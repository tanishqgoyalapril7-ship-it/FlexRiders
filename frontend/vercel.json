{
  "buildCommand": "npm run build:admin",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/admin/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/index.html"
    }
  ]
}
